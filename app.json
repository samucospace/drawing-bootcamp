{
  "expo": {
    "name": "30-Day Drawing Course",
    "slug": "drawing-bootcamp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drawingbootcamp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drawingbootcamp.app"
    },
    "android": {
      "package": "com.drawingbootcamp.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F0"
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 30-Day Drawing Course to access your photos to save sketches to your journal.",
          "cameraPermission": "Allow 30-Day Drawing Course to use your camera to photograph your sketchbook."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#BA623E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
